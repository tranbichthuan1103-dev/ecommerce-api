# Application Configuration
NODE_ENV=development
PORT=3001

# PostgreSQL Container Configuration (Used by Docker Compose)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432

# PostgreSQL Database Connection (Used when running app on Host machine)
# Note: Inside Docker Compose, service 'app' connects via hostname 'db' instead of 'localhost'
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/ecommerce_db?schema=public"

# JWT Authentication (Must be a strong secret string, minimum 32 characters)
JWT_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="1d"
